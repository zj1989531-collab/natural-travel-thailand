{
  "name": "ticket-profit-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-client-config.mjs && tsc -b && vite build && node scripts/stamp-build.mjs",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/pwa.test.mjs scripts/supabase-schema.test.mjs",
    "test:watch": "vitest",
    "sync:github": "node scripts/sync-github.mjs",
    "github:login": "node scripts/login-github.mjs",
    "sync:watch": "node scripts/sync-github.mjs --watch",
    "dev:sync": "node scripts/sync-github.mjs --watch --dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
